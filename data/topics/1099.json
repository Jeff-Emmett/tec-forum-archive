ign:right\">0.628457</td>\n</tr>\n<tr>\n<td style=\"text-align:left\">Pronoia​:octopus:<img alt=\":kangaroo:\" class=\"emoji\" src=\"https://forum.tecommons.org/images/emoji/win10/kangaroo.png?v=10\" title=\":kangaroo:\"/>#2154</td>\n<td style=\"text-align:right\">0.628457</td>\n</tr>\n<tr>\n<td style=\"text-align:left\">Anak#9256</td>\n<td style=\"text-align:right\">0.523714</td>\n</tr>\n<tr>\n<td style=\"text-align:left\">24nico#9513</td>\n<td style=\"text-align:right\">0.418971</td>\n</tr>\n<tr>\n<td style=\"text-align:left\">zero_2hero#1086</td>\n<td style=\"text-align:right\">0.418971</td>\n</tr>\n</tbody>\n</table>\n</div>",
